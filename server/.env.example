# Copy to server/.env (gitignored). `npm run api` loads it automatically.
# Never put API keys in EXPO_PUBLIC variables.
INGEST_TOKEN=replace-with-a-long-random-token
AI_PROVIDER=anthropic
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-6-astra
